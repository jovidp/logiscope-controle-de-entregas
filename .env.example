# Preencher na plataforma de hospedagem. Não versionar os valores reais.
NODE_ENV=production
TZ=America/Sao_Paulo
PORT=3000
DB_HOST=SEU_POOLER.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=
DB_SSL=1
# Certificado CA da conexão, se exigido pela configuração do projeto.
DB_SSL_CA=
DB_POOL_MAX=5
# Criar/restaurar o schema antes de iniciar a aplicação.
DB_SCHEMA=controle_entrega
GPS_NUVEM_URL=https://seuprojetosupabase.supabase.co/functions/v1/gps-coleta
GPS_LEITURA_TOKEN=
SRF_URL=
SRF_EMAIL=
SRF_SENHA=
T4S_COOKIE=
SAT_COOKIE=
# Endereços internos exigem conexão privada independente do computador do usuário.
CHECKLIST_API_URL=
ONLYOFFICE_URL=
ONLYOFFICE_USER=
ONLYOFFICE_PASS=
